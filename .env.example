# App URL for share links (e.g. https://yoursite.com or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev only: set to true to show "Skip OTP" on /login (no phone OTP for testing)
# NEXT_PUBLIC_DEV_SKIP_AUTH=true

# Supabase
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay
# https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# RazorpayX (Banking) – Penny Drop uses Razorpay API keys above
# RazorpayX Dashboard → My Account & Settings → Banking → Customer Identifier
RAZORPAYX_VALIDATION_ACCOUNT_NUMBER=

# Optional: key for encrypting bank_account_number (defaults to SUPABASE_SERVICE_ROLE_KEY)
# ENCRYPTION_KEY=

# Shiprocket
# https://app.shiprocket.in/settings/api
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external

# Interakt (WhatsApp Business API)
# https://app.interakt.ai/shop/api
INTERAKT_API_KEY=
INTERAKT_APP_ID=
